# Clear the current line and copy it to the clipboard.
# An empty line leaves the clipboard alone.
kill_line_copy() {
  [[ -n ${BUFFER//[[:space:]]/} ]] || { zle kill-whole-line; return; }
  zle kill-whole-line
  print -rn -- "${CUTBUFFER%$'\n'}" | pbcopy
}
zle -N kill_line_copy

# Delete the previous word and copy it to the clipboard.
# Empty or whitespace-only text before the cursor leaves the clipboard alone.
kill_word_copy() {
  [[ -n ${LBUFFER//[[:space:]]/} ]] || { zle backward-kill-word; return; }
  zle backward-kill-word
  print -rn -- "$CUTBUFFER" | pbcopy
}
zle -N kill_word_copy
bindkey '^w' kill_word_copy
