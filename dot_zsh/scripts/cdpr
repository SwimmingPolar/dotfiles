#!/bin/bash

# cd to the outermost git project root, walking up through nested repos.
cdpr() {
  local dir=$PWD top root

  while top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && [[ -n $top ]]; do
    root=$top
    [[ $top == / ]] && break
    dir=$(dirname "$top")
  done

  if [[ -z $root ]]; then
    echo "cdpr: not inside a git project" >&2
    return 1
  fi

  cd "$root"
}
