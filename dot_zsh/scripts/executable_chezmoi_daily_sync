#!/bin/bash
set -euo pipefail

plain=(
  "$HOME/.config/bat"
  "$HOME/.config/color.palette"
  "$HOME/.config/karabiner"
  "$HOME/.config/lf"
  "$HOME/.config/nvim"
  "$HOME/.config/wezterm"
  "$HOME/.mcp"
  "$HOME/.zsh"
)

chezmoi status | sed -n 's/^DA //p' | sort -r |
  while IFS= read -r path; do
    echo "forget: $path"
    chezmoi forget --force "$HOME/$path" </dev/null
  done

chezmoi add --secrets=error "${plain[@]}"
chezmoi re-add
