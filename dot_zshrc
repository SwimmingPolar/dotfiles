export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

typeset -U path PATH
path=(
  $HOME/go/bin
  $HOME/.local/bin
  /usr/local/bin
  $HOME/.cargo/bin
  ${path:#$HOME/.zsh/scripts}
  $HOME/.zsh/scripts
)

# Keep non-executables in PATH dirs (json, md, subdirs) out of command completion
setopt HASH_EXECUTABLES_ONLY

# omz plugins configs mandatories
zstyle :omz:plugins:ssh-agent ssh-add-args --apple-load-keychain

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit
### End of Zinit's installer chunk

#############################################
################## Prompt ###################
#############################################
zinit ice depth=1; zinit light romkatv/powerlevel10k
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

#############################################
################## Plugins ##################
#############################################
# disable zi from zinit to use zoxide's zi(interactive)
zinit wait lucid atload'_zsh_autosuggest_start; unalias zi 2>/dev/null;' light-mode for \
    zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-completions
# OMZ plugins below call functions from these OMZ libraries (clipcopy, git_current_branch)
zinit snippet OMZL::clipboard.zsh
zinit snippet OMZL::git.zsh
zinit snippet OMZP::git
zinit snippet OMZP::copypath
zinit snippet OMZP::cp
zinit snippet OMZP::docker-compose
zinit snippet OMZP::fzf
zinit snippet OMZP::ssh-agent

# Docker completion, generated with: docker completion zsh > ~/.docker/completions/_docker
fpath=($HOME/.docker/completions $fpath)

autoload -Uz compinit
compinit
zinit cdreplay -q

# Should stay the last plugin loaded
zinit light zdharma-continuum/fast-syntax-highlighting

#############################################
############# Extra Configs #################
#############################################
# Load API keys from ~/.env (top level only; zsh globs skip dotfiles)
for _file in $HOME/.env/*(N.); do
  source "$_file"
done
unset _file

#############################################
########### Environment variables ###########
#############################################
export EDITOR=nvim
export MANPAGER="sh -c 'col -bx | bat --wrap never -l man'"
export EZA_ICON_SPACING=2

#############################################
################## Aliases ##################
#############################################
alias nv="nvim"
alias l="eza -1 --icons=always"
alias ll="eza -1l --icons=always"
alias ltree="eza --icons=always --tree"
alias lt="ltree"
alias leetcode="nvim leetcode.nvim"
alias czf="chezmoi forget"
alias cza="chezmoi add"
alias cz="chezmoi"
alias czu="chezmoi re-add"
alias czdf="chezmoi diff"
alias czd="chezmoi cd"
alias lg="lazygit"
alias tmx=tmux
alias tma="tmux attach"
alias ct="cd /tmp"

#############################################
################ Keybindings ################
#############################################
# Emacs mode. Keep this first: EDITOR=nvim makes zsh start in vi mode,
# and switching keymaps later would lose the bindings made before the switch.
bindkey -e

# Move fzf file search from Ctrl-T to Ctrl-B
bindkey -r '^T'
bindkey '^b' fzf-file-widget

# Clear the screen with Alt-L instead of Ctrl-L
bindkey '^[l' clear-screen && bindkey -r '^L'

#############################################
################# Functions #################
#############################################
# lf: cd into the last directory on quit
lfcd() {
  # `command` is needed in case `lfcd` is aliased to `lf`
  cd "$(command lf -print-last-dir "$@")"
}

# cdpr
source $HOME/.zsh/scripts/cdpr

# Define color functions
black() { echo -e "$(tput setaf 0)$*$(tput sgr0)"; }
red() { echo -e "$(tput setaf 1)$*$(tput sgr0)"; }
green() { echo -e "$(tput setaf 2)$*$(tput sgr0)"; }
yellow() { echo -e "$(tput setaf 3)$*$(tput sgr0)"; }
blue() { echo -e "$(tput setaf 4)$*$(tput sgr0)"; }
magenta() { echo -e "$(tput setaf 5)$*$(tput sgr0)"; }
cyan() { echo -e "$(tput setaf 6)$*$(tput sgr0)"; }
white() { echo -e "$(tput setaf 7)$*$(tput sgr0)"; }

bright_black() { echo -e "$(tput setaf 8)$*$(tput sgr0)"; }
bright_red() { echo -e "$(tput setaf 9)$*$(tput sgr0)"; }
bright_green() { echo -e "$(tput setaf 10)$*$(tput sgr0)"; }
bright_yellow() { echo -e "$(tput setaf 11)$*$(tput sgr0)"; }
bright_blue() { echo -e "$(tput setaf 12)$*$(tput sgr0)"; }
bright_magenta() { echo -e "$(tput setaf 13)$*$(tput sgr0)"; }
bright_cyan() { echo -e "$(tput setaf 14)$*$(tput sgr0)"; }
bright_white() { echo -e "$(tput setaf 15)$*$(tput sgr0)"; }

#############################################
################### Tools ###################
#############################################
# Keep after compinit so zoxide completions work
eval "$(zoxide init zsh)"

export PYENV_ROOT="$HOME/.pyenv"
eval "$(pyenv init - zsh)"

# Added by LM Studio CLI (lms)
path+=($HOME/.cache/lm-studio/bin)

# Claude Code: use my claude.ai subscription by default
claude() { env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN claude "$@"; }
# Use the API key on purpose with: claude-api
claude-api() { command claude "$@"; }

codex() {
  if (( $# == 0 )); then
    command codex resume --last
  else
    command codex "$@"
  fi
}

# AI commands
source $HOME/.zsh/scripts/ai
